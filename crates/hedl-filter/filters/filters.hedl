 |lr106,poetry-install,strip,^Installing dependencies
 |lr107,poetry-install,strip,^Package operations
 |lr108,poetry-install,strip,^  - 
 |lr109,poetry-install,strip,^\s*$
 |lr110,pre-commit,strip,^\[INFO\]
