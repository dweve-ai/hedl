match_rules: @MatchRule
 |mr1,rsync,total size is,ok (synced),error|failed

tests: @FilterTest
 |t1,make,strips noise,"make[1]: Entering directory '/home/user'\ngcc -O2 foo.c\nmake[1]: Leaving directory '/home/user'\n","gcc -O2 foo.c\n"
