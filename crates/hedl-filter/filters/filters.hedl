 |lr115,quarto-render,strip,^\s*$
 |lr116,rsync,strip,^sending incremental
 |lr117,rsync,strip,^\s*$
 |lr118,shellcheck,strip,^\s*$
 |lr119,shopify-theme,strip,^\[
 |lr120,shopify-theme,strip,^\s*$
