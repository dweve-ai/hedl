 |lr167,tofu-fmt,strip,^\s*$
 |lr168,tofu-init,strip,^Initializing
 |lr169,tofu-init,strip,^Downloading
 |lr170,tofu-init,strip,^Installing
 |lr171,tofu-init,strip,^\s*$
 |lr172,tofu-plan,strip,^Refreshing state
