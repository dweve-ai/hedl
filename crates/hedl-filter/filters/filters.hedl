 |lr66,iptables,strip,^\s*$
 |lr67,jira,strip,^\s*$
 |lr68,jj,strip,^Working copy
 |lr69,jj,strip,^\s*$
 |lr70,jq,strip,^\s*$
 |lr71,just,strip,^\s*$
 |lr72,liquibase,strip,^Starting Liquibase
 |lr73,liquibase,strip,^Liquibase Version
 |lr74,liquibase,strip,^Liquibase Command
 |lr75,liquibase,strip,^\s*$
 |lr76,make,strip,^make\[\d+\]:
 |lr77,make,strip,^\s*$
 |lr78,markdownlint,strip,^\s*$
 |lr79,mise,strip,^\s*$
 |lr80,mix-compile,strip,^Compiling
 |lr81,mix-compile,strip,^Generated
 |lr82,mix-compile,strip,^\s*$
 |lr83,mvn-build,strip,^\[INFO\] \s*Download
 |lr84,mvn-build,strip,^\[INFO\] \s*---
 |lr85,mvn-build,strip,^\[INFO\] \s*Building
 |lr86,mvn-build,strip,^\[INFO\] \s*Reactor Summary
 |lr87,mvn-build,strip,^\[INFO\] \s*Total time
 |lr88,mvn-build,strip,^\[INFO\] \s*Finished at
 |lr89,mvn-build,strip,^\[INFO\] \s*Final Memory
 |lr90,mvn-build,strip,^\[INFO\] \s*------------------------------------------------------------------------
 |lr91,mvn-build,strip,^\[INFO\] \s*BUILD SUCCESS
 |lr92,mvn-build,strip,^\[INFO\] \s*BUILD FAILURE
 |lr93,mvn-build,strip,^\s*$
 |lr94,nx,strip,^>
 |lr95,nx,strip,^\s*$
 |lr96,ollama,strip,^pulling
 |lr97,ollama,strip,^\s*$
 |lr98,oxlint,strip,^\s*$
 |lr99,ping,strip,^PING
 |lr100,ping,strip,^\d+ bytes from
 |lr101,pio-run,strip,^Processing
 |lr102,pio-run,strip,^Building
 |lr103,pio-run,strip,^Linking
 |lr104,pio-run,strip,^Checking
