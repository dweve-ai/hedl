%V:2.0
%NULL:~
%QUOTE:"
%S:Filter:[name, description, match_command, strip_ansi, truncate_lines_at, head_lines, tail_lines, max_lines, on_empty, filter_stderr]
%S:LineRule:[id, filter_name, action, pattern]
%S:ReplaceRule:[id, filter_name, pattern, replacement]
%S:MatchRule:[id, filter_name, pattern, message, unless]
%S:FilterTest:[id, filter_name, test_name, input, expected]
---

filters: @Filter
 |ansible-playbook,Strip Ansible task ok/changed noise,^ansible-playbook,true,,,,,,false
 |basedpyright,Strip basedpyright progress,^basedpyright,true,,,,,,false
 |biome,Strip biome progress,^biome,true,,,,,,false
 |brew-install,Strip Homebrew download progress,^brew\s+(install|upgrade|reinstall),true,,,,,,false
 |bundle-install,Strip bundle install progress,^bundle\s+install,true,,,,,,false
 |composer-install,Strip Composer download progress,^composer\s+(install|update|require),false,,,,,,false
 |df,Compact df output,^df\b,false,,,,,,false
 |du,Compact du output,^du\b,false,,30,,,,false
 |fail2ban-client,Strip fail2ban status noise,^fail2ban-client,false,,,,,,false
 |gcc,Strip GCC compilation progress,^gcc\b,false,,,,,,false
 |gcloud,Strip gcloud progress and headers,^gcloud\b,true,,,,,,false
 |gradle,Strip Gradle build progress,^gradle\b,true,,,,,,false
 |hadolint,Strip hadolint noise,^hadolint,false,,,,,,false
 |helm,Strip Helm install/upgrade progress,^helm\b,true,,,,,,false
 |iptables,Strip iptables noise,^iptables,false,,,,,,false
 |jira,Strip Jira CLI noise,^jira,true,,,,,,false
 |jj,Strip jujutsu progress,^jj\b,true,,,,,,false
 |jq,Strip jq output noise,^jq\b,false,,100,,,,false
 |just,Strip just progress,^just\b,true,,,,,,false
 |liquibase,Strip Liquibase banner and progress,^liquibase,true,,,,,,false
 |make,Strip make entering/leaving directory noise,^make\b,false,,,,,,false
 |markdownlint,Strip markdownlint noise,^markdownlint,false,,,,,,false
 |mise,Strip mise progress,^mise,true,,,,,,false
 |mix-compile,Strip mix compile progress,^mix\s+compile,true,,,,,,false
 |mvn-build,Strip Maven download and progress,^mvn\b,true,,,,,,false
 |nx,Strip nx build progress,^nx\b,true,,,,,,false
 |ollama,Strip ollama progress,^ollama,true,,,,,,false
 |oxlint,Strip oxlint progress,^oxlint,true,,,,,,false
 |ping,Compact ping output,^ping\b,false,,,,,,false
 |pio-run,Strip PlatformIO build progress,^pio\s+run,true,,,,,,false
 |poetry-install,Strip poetry install progress,^poetry\s+(install|update|add),true,,,,,,false
 |pre-commit,Strip pre-commit hook noise,^pre-commit,true,,,,,,false
 |quarto-render,Strip Quarto render progress,^quarto\s+render,true,,,,,,false
 |rsync,"Strip rsync progress, keep summary",^rsync,true,,,,,,false
 |shellcheck,Strip shellcheck banner,^shellcheck,false,,,,,,false
 |shopify-theme,Strip shopify theme progress,^shopify\s+theme,true,,,,,,false
 |skopeo,Strip skopeo progress,^skopeo,true,,,,,,false
 |sops,Strip sops metadata,^sops,false,,,,,,false
 |spring-boot,Strip Spring Boot build progress,^\./mvnw\b,true,,,,,,false
 |ssh,Strip ssh connection noise,^ssh\b,false,,,,,,false
 |stat,Compact stat output,^stat\b,false,,,,,,false
 |swift-build,Strip Swift build progress,^swift\s+build,true,,,,,,false
 |systemctl-status,Compact systemctl status,^systemctl\s+status,true,,,,,,false
 |task,Strip taskfile progress,^task\b,true,,,,,,false
 |terraform-apply,Strip terraform apply refresh noise,^terraform\s+apply,true,,,,,,false
 |terraform-plan,Strip terraform refresh state noise,^terraform\s+plan,true,,,,,,false
 |tofu-fmt,OpenTofu fmt check,^tofu\s+fmt,false,,,,,,false
 |tofu-init,Strip OpenTofu init progress,^tofu\s+init,true,,,,,,false
 |tofu-plan,OpenTofu plan - strip refresh noise,^tofu\s+plan,true,,,,,,false
 |tofu-validate,OpenTofu validate,^tofu\s+validate,true,,,,,,false
 |trunk-build,Strip trunk build progress,^trunk\s+build,true,,,,,,false
 |turbo,Strip turbo build progress,^turbo\b,true,,,,,,false
 |ty,Strip ty (typos) progress,^ty\b,true,,,,,,false
 |uv-sync,Strip uv sync progress,^uv\s+sync,true,,,,,,false
 |xcodebuild,Strip xcodebuild progress,^xcodebuild,true,,,,,,false
 |yadm,Strip yadm status noise,^yadm,true,,,,,,false
 |yamllint,Strip yamllint noise,^yamllint,false,,,,,,false

line_rules: @LineRule
 |lr1,ansible-playbook,strip,^\s*ok=
 |lr2,ansible-playbook,strip,^\s*changed=
 |lr3,ansible-playbook,strip,^\s*unreachable=
 |lr4,ansible-playbook,strip,^\s*failed=
 |lr5,ansible-playbook,strip,^\s*skipped=
 |lr6,ansible-playbook,strip,^\s*rescued=
 |lr7,ansible-playbook,strip,^\s*ignored=
 |lr8,ansible-playbook,strip,^TASK \[
 |lr9,ansible-playbook,strip,^PLAY \[
 |lr10,ansible-playbook,strip,^\s*$
 |lr11,basedpyright,strip,^\s*$
 |lr12,biome,strip,^Checked
 |lr13,biome,strip,^\s*$
 |lr14,brew-install,strip,^==> \s*Downloading
 |lr15,brew-install,strip,^==> \s*Pouring
 |lr16,brew-install,strip,^==> \s*Fetching
 |lr17,brew-install,strip,^==> \s*Cloning
 |lr18,brew-install,strip,^==> \s*Checking out
 |lr19,brew-install,strip,^==> \s*Auto-updated
 |lr20,brew-install,strip,Already downloaded
 |lr21,brew-install,strip,^\s*$
 |lr22,bundle-install,strip,^Fetching
 |lr23,bundle-install,strip,^Installing
 |lr24,bundle-install,strip,^Using
 |lr25,bundle-install,strip,^Bundle complete
 |lr26,bundle-install,strip,^\s*$
 |lr27,composer-install,strip,^Loading composer repositories
 |lr28,composer-install,strip,^Updating dependencies
 |lr29,composer-install,strip,^Dependency resolution
 |lr30,composer-install,strip,^Package operations
 |lr31,composer-install,strip,^  - 
 |lr32,composer-install,strip,^Generating autoload files
 |lr33,composer-install,strip,^\s*$
 |lr34,df,strip,^Filesystem
 |lr35,df,strip,^tmpfs
 |lr36,df,strip,^devtmpfs
 |lr37,df,strip,^udev
 |lr38,df,strip,^overlay
 |lr39,df,strip,^cgroup
 |lr40,du,strip,^\s*$
 |lr41,fail2ban-client,strip,^Status for
 |lr42,fail2ban-client,strip,^\s*-
 |lr43,fail2ban-client,strip,^\s*\[`
 |lr44,fail2ban-client,strip,^\s*$
 |lr45,gcc,strip,^\s*$
 |lr46,gcloud,strip,^Creating
